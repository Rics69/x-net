                    "minLength": 3,
                    "example": "Ivan Ivanov"
                },
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 8,
                    "example": "supersecret"
                },
                "phone_number": {
                    "type": "string",
                    "maxLength": 15,
                    "minLength": 10,
                    "example": "+79999998877"
                },
                "username": {
                    "type": "string",
