HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_TIMEOUT=10s

LOGGER_LEVEL=DEBUG
TIME_ZONE=UTC

# минимум 32 байта. Сгенерить в терминале: openssl rand -base64 48
# и вставить сюда САМО значение: make и docker compose не выполняют $(...) в .env
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=24h
AUTH_COOKIE_SECURE=false

# false - брокер не нужен, события ленты доходят только до клиентов этого же инстанса
RABBITMQ_ENABLED=true
RABBITMQ_USER=xchat
RABBITMQ_PASSWORD=
